NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
CONTENT_SYNC_SECRET=
PORTAL_ANALYTICS_MAINTENANCE_SECRET=

# Server-only Mailchimp newsletter sync. The server prefix can be omitted when
# the API key ends with the data-center suffix (for example, "-us10").
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
# Optional but recommended: limits imports to the dedicated newsletter folder.
MAILCHIMP_NEWSLETTER_FOLDER_ID=

# Monthly newsletter summary and photo-only cover generation. The generated
# photo is rendered with the deterministic IPN masthead and stored in the
# existing Supabase content-images bucket by a Netlify background function.
OPENAI_API_KEY=
OPENAI_NEWSLETTER_TEXT_MODEL=gpt-5-mini
OPENAI_NEWSLETTER_IMAGE_MODEL=gpt-image-1
SLACK_FEEDBACK_WEBHOOK_URL=
SLACK_MEMBER_REGISTRATIONS_WEBHOOK_URL=
SLACK_EVENT_RSVPS_WEBHOOK_URL=

RESEND_API_KEY=
EVENT_EMAIL_FROM="IPN Events <events@members.intercollegiatepsychedelics.net>"
EVENT_EMAIL_REPLY_TO=info@intercollegiatepsychedelics.net
MEMBER_NOTIFICATION_MODE=off
MEMBER_NOTIFICATION_TEST_RECIPIENTS=
EVENT_REGISTRATION_REMINDERS_ENABLED=false
MEMBER_EMAIL_FROM="IPN Member Portal <members@members.intercollegiatepsychedelics.net>"
MEMBER_EMAIL_REPLY_TO=info@intercollegiatepsychedelics.net

EVENTBRITE_API_TOKEN=
EVENTBRITE_ORG_ID=
EVENTBRITE_PSYCHEDELX_2026_EVENT_ID=

# Server-only WhatsApp group invites. Never prefix these with NEXT_PUBLIC_.
WHATSAPP_GENERAL_INVITE_URL=
WHATSAPP_LABS_INVITE_URL=
WHATSAPP_CONFERENCES_INVITE_URL=
