NEXT_PUBLIC_MAPBOX_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
CONTENT_SYNC_SECRET=
PORTAL_ANALYTICS_MAINTENANCE_SECRET=

# Newsletter imports use the public Mailchimp archive feed; no API/AI key required.
# MAILCHIMP_API_KEY is still used by separate member/analytics integrations.
MAILCHIMP_API_KEY=

SLACK_FEEDBACK_WEBHOOK_URL=
SLACK_MEMBER_REGISTRATIONS_WEBHOOK_URL=
SLACK_EVENT_RSVPS_WEBHOOK_URL=

RESEND_API_KEY=
EVENT_EMAIL_FROM="IPN Events <events@members.intercollegiatepsychedelics.net>"
EVENT_EMAIL_REPLY_TO=info@intercollegiatepsychedelics.net
MEMBER_NOTIFICATION_MODE=off
MEMBER_NOTIFICATION_TEST_RECIPIENTS=
EVENT_REGISTRATION_REMINDERS_ENABLED=false
MEMBER_EMAIL_FROM="IPN Member Portal <members@members.intercollegiatepsychedelics.net>"
MEMBER_EMAIL_REPLY_TO=info@intercollegiatepsychedelics.net

EVENTBRITE_API_TOKEN=
EVENTBRITE_ORG_ID=
EVENTBRITE_PSYCHEDELX_2026_EVENT_ID=

# Server-only WhatsApp group invites. Never prefix these with NEXT_PUBLIC_.
WHATSAPP_GENERAL_INVITE_URL=
WHATSAPP_LABS_INVITE_URL=
WHATSAPP_CONFERENCES_INVITE_URL=

# Leadership workflows: metadata in Supabase, file links in Drive/Canva.
# Enable only after migration, Slack app setup and service-account sharing.
WORKFLOW_INTEGRATION_MODE=off
# Comma-separated IDs of simulated preview requests to retain but quarantine.
WORKFLOW_EXCLUDED_REQUEST_IDS=
WORKFLOW_SLACK_BOT_TOKEN=
WORKFLOW_SLACK_SIGNING_SECRET=
WORKFLOW_SLACK_TEAM_ID=
WORKFLOW_MEDIA_SLACK_CHANNEL_ID=C088ZJBM0QY
WORKFLOW_EXPENSE_SLACK_CHANNEL_ID=
WORKFLOW_GOOGLE_CLIENT_EMAIL=
# JSON service-account private key; literal \n is accepted.
WORKFLOW_GOOGLE_PRIVATE_KEY=

# Guest RSVP: set these only for Netlify Production (Builds + Functions scopes).
# Apply the guest RSVP migration before enabling, then opt in the intended event.
GUEST_EVENT_RSVP_ENABLED=false
GUEST_EVENT_EMAIL_MODE=off
GUEST_EVENT_TOKEN_SECRET=
